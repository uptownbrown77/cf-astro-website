---
// index.astro - Clean Homepage Slate
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Strength. Loyalty. Legacy.</title>
  </head>
  <body>
    <main class="hero hero-home">
      <div class="hero-display-title">
        <span>STRENGTH.</span>
        <span>LOYALTY.</span>
        <span>LEGACY.</span>
      </div>
      <div class="gold-rule"><i></i></div>
    </main>
  </body>
</html>

<style>
.hero {
  min-height: clamp(640px, 76vh, 900px);
  display: grid;
  align-items: center;
  position: relative;
}
.hero-home {
  background-image: linear-gradient(145deg, #17130d, #020202 72%), url('/images/near-black-stone-texture.png') !important;
  background-position: center center;
  background-size: cover;
  isolation: auto !important;
}
.hero::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: url('/images/hero-cane-corso-contrast-v1.png') !important;
  background-position: center center;
  background-size: contain;
  background-repeat: no-repeat;
  mix-blend-mode: screen;
  filter: contrast(1.08) drop-shadow(0 10px 12px #000);
  pointer-events: none;
}
.hero-display-title {
  display: grid;
  justify-items: start;
  gap: .85rem;
  padding-left: 10%;
  z-index: 2;
}
.hero-display-title span {
  display: block;
  white-space: nowrap;
  font-size: clamp(2.5rem, 6vw, 5rem);
  font-weight: 900;
  color: #fff;
  text-shadow: 0 4px 10px rgba(0,0,0,0.7);
}
.hero .gold-rule {
  width: min(100%, 520px);
  height: 2px;
  margin: .65rem 0 .85rem 10%;
  background: linear-gradient(90deg, #d4af37, transparent);
  z-index: 2;
}
@media(max-width:900px){
  .hero-home::before{background-position: 68% center;}
}
@media(max-width:600px){
  .hero-home{min-height: 720px; align-items: start; padding-top: 4rem;}
  .hero-home::before{background-position: 80% center;}
}
</style>