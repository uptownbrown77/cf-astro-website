---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Strength. Loyalty. Legacy.">
  <main class="hero hero-home">
    <div class="hero-display-title">
      <span>STRENGTH.</span>
      <span>LOYALTY.</span>
      <span>LEGACY.</span>
    </div>
    <div class="hero-gold-rule"><i></i></div>
  </main>
</Layout>

<style>
.hero-home {
  min-height: clamp(640px, 76vh, 900px);
  display: grid;
  align-items: center;
  position: relative;
}
.hero-home {
  background-image: linear-gradient(145deg, #17130d, #020202 72%), url('/images/near-black-stone-texture.png') !important;
  background-position: center center;
  background-size: cover;
  isolation: auto !important;
}
.hero::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: url('/images/hero-cane-corso-written-word-v1.png') !important;
  background-position: center center;
  background-size: contain;
  background-repeat: no-repeat;
  mix-blend-mode: screen;
  filter: contrast(1.05) drop-shadow(0 10px 15px #000000);
  pointer-events: none;
  z-index: 1;
}
.hero-display-title {
  display: grid;
  justify-items: start;
  gap: .85rem;
  z-index: 2;
}
.hero-display-title span {
  display: block;
  white-space: nowrap;
}
.hero .gold-rule {
  width: min(100%, 520px);
  height: 26px;
  margin: .65rem 0 .85rem;
  background: linear-gradient(90deg, #17130d, #020202);
  z-index: 2;
}
.hero .gold-rule::before,
.hero-home .gold-rule::after,
.hero-home .gold-rule i {
  display: inline-block;
}
@media(max-width:900px) {
  .hero-home { background-position: 68% center; }
  .hero::before { background-position: 68% center; }
}
@media(max-width:600px) {
  .hero-home { min-height: 720px; background-position: 80% center; align-items: start; padding-top: 4rem; }
  .hero::before { background-position: 80% center; }
}
</style>