---
import Layout from '../layouts/Layout.astro';
import { ArrowRight } from 'lucide-astro';
import HeraldicAsset from '../components/HeraldicAsset.astro';
import HeraldicIcon from '../components/HeraldicIcon.astro';
import { pillars, featureCards, missionStatement } from '../data/site';
---
<Layout title="Home" description="Custos Fidelis Cane Corso — preserving and improving the ancient breed through heavy bone, sound structure, stable temperament, tailored training, and dependable protection.">
  <section class="home-hero">
    <div class="hero-content">
      <h1 class="display-title"><span>Strength.</span><span>Loyalty.</span><span>Legacy.</span></h1>
      <p class="hero-lead">Preserve the legacy. Improve every generation.</p>
      <p>Heavy bone. Sound movement. Stable temperament. Dependable protection for modern life.</p>
      <a class="button" href="/our-dogs">Explore Our Dogs <ArrowRight size={17}/></a>
    </div>
    <aside class="hero-seal" aria-label="Custos Fidelis Cane Corso crest"><img src="/images/custos-fidelis-logo-color-restored.png" alt="Custos Fidelis Cane Corso" width="1024" height="1536" /></aside>
  </section>

  <div class="section-shell home-stack">
    <section class="video-stage video-stage-blank gold-frame" aria-label="Blank video placeholder"></section>

    <section class="pillars gold-frame" aria-label="Our principles">
      {pillars.map((pillar, index) => <article>
        <div class="pillar-icon"><HeraldicIcon name={['heritage','eagle','guardian','paw'][index]} label={pillar.title}/></div>
        <span class="roman-ribbon">Custos Fidelis</span><h2>{pillar.title}</h2><p>{pillar.text}</p>{index < pillars.length - 1 && <span class="divider"></span>}
      </article>)}
    </section>

    <section class="feature-grid">
      {featureCards.map((card, i) => <article class:list={['feature-card','gold-frame',card.className]}>
        <div class="card-visual" aria-hidden="true"><HeraldicIcon name={['champion','paw','eagle'][i]} /></div>
        <div class="card-body"><h2>{card.title}</h2><p>{card.text}</p><a class="button" href={card.href}>{card.cta}<ArrowRight size={16}/></a></div>
      </article>)}
    </section>

    <section class="mission-banner gold-frame">
      <div class="mission-crest"><img src="/images/custos-fidelis-logo-color-restored.png" alt="Custos Fidelis Cane Corso crest" width="1024" height="1536" /></div>
      <div><span class="eyebrow">An ancient breed. A higher standard.</span><h2 class="section-title">Preserve & Improve</h2><p>{missionStatement}</p><a class="button" href="/our-mission">Our Mission <ArrowRight size={16}/></a></div>
    </section>
  </div>
</Layout>

<script>
  document.querySelector('[data-play]')?.addEventListener('click', (event) => {
    const stage = (event.currentTarget as HTMLElement).closest('.video-stage');
    stage?.classList.toggle('playing');
    const copy = stage?.querySelector('.video-copy p');
    if (copy) copy.textContent = stage?.classList.contains('playing') ? 'Video placeholder active — connect your final film here.' : 'Our story film is coming soon.';
  });
</script>

<style>
  .home-hero {
    min-height: clamp(640px, 76vh, 900px);
    display: grid;
    align-items: center;
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid var(--gold);
    background-image: linear-gradient(145deg, #17130d, #020202 72%), url('images/near-black-stone-texture.png') !important;
    background-position: center center;
    background-size: cover;
    background-repeat: no-repeat;
    overflow: hidden;
  }
  .home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, #020202 0%, #020202ea 22%, #0202027e 50%, transparent 75%), linear-gradient(0deg, #020202aa, transparent 35%);
  }
  .hero-content {
    width: min(50%, 700px);
    margin-left: max(2rem, calc((100% - var(--content)) / 2));
    padding: 5rem 0;
  }
  .hero-content .display-title {
    font-size: clamp(3rem, 6vw, 6.7rem);
  }
  .hero-content p {
    max-width: 590px;
    color: #e5dfd5;
    font-size: clamp(.95rem, 1.4vw, 1.15rem);
  }
  .hero-content .hero-lead {
    color: var(--gold-pale);
    font: 500 clamp(1rem, 2vw, 1.35rem)/1.4 var(--font-display);
    letter-spacing: .08em;
  }
  .hero-content .button {
    margin-top: 1.2rem;
  }
  .hero-seal {
    position: absolute;
    right: clamp(1rem, 3vw, 3.5rem);
    bottom: 1.5rem;
    width: clamp(120px, 13vw, 180px);
    filter: drop-shadow(0 10px 16px #000);
  }
  .hero-seal img {
    width: 100%;
    height: auto;
  }
  .home-stack {
    display: grid;
    gap: 4px;
    padding-block: 4px 0;
  }
  .video-stage {
    position: relative;
    min-height: clamp(360px, 48vw, 650px);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: radial-gradient(circle at 50% 45%, #251a0c 0, #080706 24%, #010101 65%);
  }
  .video-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 20%, #db9d2430 50%, transparent 80%);
    transform: translateX(-100%);
    transition: 1.2s;
  }
  .video-stage.playing::before {
    transform: translateX(100%);
  }
  .video-stage::after {
    content: "";
    position: absolute;
    inset: 8%;
    opacity: .12;
    background: repeating-linear-gradient(90deg, transparent 0 8%, var(--gold) 8.2% 8.3%);
  }
  .play-button {
    z-index: 2;
    width: 90px;
    height: 90px;
    display: grid;
    place-items: center;
    color: var(--gold-pale);
    border: 2px solid var(--gold-bright);
    border-radius: 50%;
    background: #050505cc;
    box-shadow: 0 0 30px #c488223d;
    cursor: pointer;
    transition: .2s;
  }
  .play-button:hover {
    transform: scale(1.08);
    background: #1c1205;
  }
  .video-copy {
    position: absolute;
    left: clamp(1.5rem, 5vw, 5rem);
    bottom: clamp(1.5rem, 4vw, 4rem);
    z-index: 2;
  }
  .video-copy h2 {
    margin: .2rem 0;
    font: 500 clamp(1.6rem, 3vw, 3rem)/1.2 var(--font-display);
    color: var(--gold-pale);
  }
  .video-copy p {
    margin: 0;
    color: #9b9388;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: #060606;
  }
  .pillars article {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    padding: 2rem 1.35rem;
  }
  .pillars h2 {
    max-width: 220px;
    color: var(--gold-pale);
    font: 500 1.22rem/1.35 var(--font-display);
    text-transform: uppercase;
  }
  .pillars p {
    max-width: 230px;
    margin: 0;
    color: #d1c9be;
    font-size: .88rem;
  }
  .pillar-icon {
    height: 58px;
    display: grid;
    place-items: center;
    color: var(--gold-bright);
    font-size: 2.4rem;
  }
  .pillar-icon.shield {
    width: 52px;
    border: 2px solid var(--gold);
    clip-path: polygon(50% 0, 100% 18%, 87% 76%, 50% 100%, 13% 76%, 0 18%);
  }
  .divider {
    position: absolute;
    right: 0;
    top: 10%;
    bottom: 10%;
    width: 1px;
    background: linear-gradient(transparent, var(--gold), transparent);
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }
  .feature-card {
    min-height: 510px;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    background: #050505;
  }
  .card-visual {
    display: grid;
    place-items: center;
    position: relative;
    min-height: 260px;
    background: radial-gradient(circle at 50% 40%, #8d601f40, transparent 23%), linear-gradient(145deg, #2a241a, #050505 58%);
  }
  .card-visual::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, #050505, transparent 70%), repeating-radial-gradient(circle at 50% 100%, transparent 0 18px, #c3902520 19px 20px);
  }
  .card-visual span {
    position: relative;
    font: 700 clamp(3rem, 7vw, 6rem)/1 var(--font-display);
    color: #c9973e25;
    text-shadow: 0 0 50px var(--gold);
  }
  .puppies .card-visual span {
    font-size: 6rem;
  }
  .bloodlines .card-visual {
    background: radial-gradient(circle at 50% 50%, #a773263d, transparent 3%, #070707 30%), linear-gradient(120deg, #191713, #030303);
  }
  .card-body {
    text-align: center;
    padding: 0 1.6rem 1.8rem;
  }
  .card-body h2 {
    margin: .4rem 0;
    color: var(--gold-pale);
    font: 500 clamp(1.5rem, 2.3vw, 2.25rem)/1.2 var(--font-display);
  }
  .card-body p {
    min-height: 3.2em;
    margin: .6rem auto 1.2rem;
    max-width: 390px;
    color: #ded7cc;
  }
  .mission-banner {
    min-height: 390px;
    display: grid;
    grid-template-columns: 240px 1fr 200px;
    gap: 2rem;
    align-items: center;
    padding: 2.2rem;
    background: radial-gradient(circle at 25% 50%, #35240950, transparent 25%), linear-gradient(90deg, #080705, #10100e 55%, #030303);
  }
  .mission-crest {
    display: grid;
    place-items: center;
  }
  .mission-crest img {
    width: min(100%, 220px);
    max-height: 300px;
    object-fit: contain;
    filter: drop-shadow(0 10px 20px #000);
  }
  .mission-banner p {
    max-width: 780px;
    color: #ded5c7;
  }
  .centurion {
    align-self: end;
    color: var(--gold-pale);
    font-size: 12rem;
    line-height: .8;
    opacity: .38;
    text-shadow: 0 0 45px var(--gold);
  }
  .breeding-standard {
    padding: clamp(2rem, 5vw, 4.5rem);
    background: radial-gradient(circle at 50% 0, #553a102e, transparent 34%), #070706;
  }
  .breeding-standard>header {
    text-align: center;
    display: grid;
    justify-items: center;
    margin-bottom: 2rem;
  }
  .standard-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: #745219;
  }
  .standard-grid article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.2rem;
  }
</style>
