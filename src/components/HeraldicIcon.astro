---
interface Props { name: string; label?: string; class?: string; }
const { name, label = '', class: className = '' } = Astro.props;
const collection = 'icons-v2';
---
<span class:list={['site-heraldic-icon', className]} role={label ? 'img' : undefined} aria-label={label || undefined} aria-hidden={label ? undefined : 'true'}>
  <img src={`/images/heraldry/${collection}/${name}.png`} alt="" loading="lazy" />
</span>

<style>
  .site-heraldic-icon{display:grid;place-items:center;width:var(--icon-size,120px);height:var(--icon-size,120px);padding:var(--icon-safe-area,6%);overflow:hidden;box-sizing:border-box}
  img{display:block;width:100%;height:100%;max-width:100%;max-height:100%;object-fit:contain;object-position:center;mix-blend-mode:screen;filter:saturate(.82) contrast(1.08) drop-shadow(0 8px 8px #000)}
</style>
