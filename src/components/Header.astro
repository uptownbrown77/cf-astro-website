---
import { Menu, X } from 'lucide-astro';
import { navItems } from '../data/site';
const path = Astro.url.pathname;
---
<header class="site-header" data-header>
  <div class="header-inner gold-frame">
    <a class="header-banner" href="/" aria-label="Custos Fidelis home">
      <img src="/images/custos-fidelis-header-title.png" alt="Custos Fidelis" width="1570" height="315" />
    </a>
    <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" data-menu-toggle>
      <Menu class="open-icon" size={23}/><X class="close-icon" size={23}/>
    </button>
    <nav class="main-nav" aria-label="Main navigation" data-nav>
      {navItems.map((item) => <a class:list={{active: path === item.href}} href={item.href}>{item.label}</a>)}
      <a class="waitlist-btn" href="/join-waitlist">Join Waitlist</a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('[data-nav]');
  const setMenuOpen = (open) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    nav?.classList.toggle('open', open);
    document.documentElement.classList.toggle('nav-open', open);
  };
  toggle?.addEventListener('click', () => setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenuOpen(false); });
  window.addEventListener('resize', () => { if (window.innerWidth > 1100) setMenuOpen(false); });
</script>

<style>
  .site-header{position:sticky;top:0;z-index:50;padding:.55rem;background:rgba(2,2,2,.96);backdrop-filter:blur(18px);border-bottom:1px solid #2b210d}
  .header-inner{min-height:158px;display:grid;grid-template-columns:1fr auto 1fr;grid-template-rows:82px auto;align-items:center;gap:.1rem 1.2rem;padding:.45rem 2rem .75rem;overflow:hidden;border:0!important;outline:1px solid #5d3a0d;background-color:#030303;background-image:url('/images/heraldry/assets/roman-scroll-corner-tl.png'),url('/images/heraldry/assets/roman-scroll-corner-tr.png'),url('/images/heraldry/assets/roman-scroll-corner-bl.png'),url('/images/heraldry/assets/roman-scroll-corner-br.png'),radial-gradient(circle at 50% 35%,#17130d 0,#080706 38%,#020202 76%);background-repeat:no-repeat;background-size:58px 65px,58px 65px,58px 65px,58px 65px,auto;background-position:left top,right top,left bottom,right bottom,center;box-shadow:inset 0 0 0 2px #d09a3b,inset 0 0 0 5px #211506,inset 0 0 0 6px #8f6424,inset 0 0 34px #000,0 8px 24px #000!important}.header-inner::before,.header-inner::after{display:none!important;content:none!important}.header-banner{grid-column:1/-1;grid-row:1;justify-self:center;display:block;width:clamp(390px,43vw,680px);height:78px;text-decoration:none}.header-banner img{display:block;width:100%;height:100%;object-fit:contain;object-position:center;mix-blend-mode:screen;filter:brightness(1.06) contrast(1.1) drop-shadow(0 4px 8px #000)}.main-nav{grid-column:1/-1;grid-row:2;display:flex;align-items:center;justify-self:center;justify-content:center;gap:.42rem;max-width:100%}
  .main-nav a{position:relative;padding:.82rem .82rem;color:#f0e9dc;text-decoration:none;text-transform:uppercase;font-size:.69rem;letter-spacing:.075em;border:1px solid #6e5119;background:linear-gradient(#15130f,#070707);clip-path:polygon(6px 0,calc(100% - 6px) 0,100% 6px,100% calc(100% - 6px),calc(100% - 6px) 100%,6px 100%,0 calc(100% - 6px),0 6px);white-space:nowrap;transition:.25s}
  .main-nav a:hover,.main-nav a.active{color:#fff2bf;border-color:var(--gold-bright);box-shadow:inset 0 0 18px #6f440d66,0 0 12px #d99a2655}.main-nav .waitlist-btn{color:#160e02;background:linear-gradient(180deg,#ffe08a,#b97912 72%,#754508);font-weight:800;padding-inline:1rem}
  .menu-toggle{display:none;grid-column:3;justify-self:end;color:var(--gold-pale);background:#0b0b0b;border:1px solid var(--gold);padding:.65rem}.close-icon{display:none}.menu-toggle[aria-expanded=true] .open-icon{display:none}.menu-toggle[aria-expanded=true] .close-icon{display:block}
  @media (max-width:1100px){.site-header{overflow:visible}.header-inner{position:relative;overflow:visible;min-height:96px;grid-template-rows:1fr;padding:.3rem 1.35rem;background-size:50px 56px,50px 56px,50px 56px,50px 56px,auto}.header-banner{grid-column:2;grid-row:1;width:clamp(280px,48vw,510px);height:72px}.header-banner img{height:100%;object-fit:contain}.menu-toggle{display:grid;place-items:center;grid-row:1;margin-right:.85rem;position:relative;z-index:72}.main-nav{display:none;position:absolute;z-index:70;top:calc(100% + .55rem);left:0;right:0;padding:1rem;background:#050505;border:1px solid var(--gold);box-shadow:0 18px 35px #000;grid-template-columns:repeat(2,minmax(0,1fr));max-height:calc(100dvh - 125px);overflow-y:auto;overscroll-behavior:contain}.main-nav.open{display:grid}.main-nav a{text-align:center;min-width:0}.main-nav .waitlist-btn{grid-column:1/-1}}
  @media(max-width:520px){.main-nav{grid-template-columns:1fr;max-height:calc(100vh - 110px);overflow:auto}.main-nav .waitlist-btn{grid-column:auto}.header-inner{min-height:88px;padding:.25rem .65rem;background-size:42px 47px,42px 47px,42px 47px,42px 47px,auto}.header-banner{width:min(62vw,300px)}.header-banner img{height:68px}.menu-toggle{padding:.55rem;margin-right:.65rem}}
</style>
